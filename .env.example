# Global BhashaSense Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# ML Hardware & Pipeline Configuration
# Options: auto, cuda, mps, cpu
DEVICE=auto
# Set to true to run instant realistic mock inferences (ideal for UI testing & machines without GPU)
MOCK_ML_MODELS=true

# Model Identifiers
ASR_MODEL_ID=ai4bharat/indicconformer_all
SENTIMENT_MODEL_ID=ai4bharat/indic-bert
SPACY_MODEL_ID=xx_ent_wiki_sm
MODELS_CACHE_DIR=./models_cache
UPLOAD_DIR=./storage/uploads

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
