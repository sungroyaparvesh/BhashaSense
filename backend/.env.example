# Backend Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Hardware & Inference
DEVICE=auto
# Set MOCK_ML_MODELS=true for instant local testing without loading heavy GB weights
MOCK_ML_MODELS=true

# Model Checkpoints & Directories
ASR_MODEL_ID=ai4bharat/indicconformer_all
SENTIMENT_MODEL_ID=ai4bharat/indic-bert
SPACY_MODEL_ID=xx_ent_wiki_sm
MODELS_CACHE_DIR=./models_cache
UPLOAD_DIR=./storage/uploads
MAX_AUDIO_SIZE_MB=50
ALLOWED_AUDIO_FORMATS=["wav", "mp3", "m4a", "flac", "ogg"]
